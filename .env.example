ENVIRONMENT=development
PAYMENT_PROVIDER=disabled
EXPORT_DIRECTORY=/var/lib/caspra/exports
DEBUG=false
DATABASE_URL=postgresql+asyncpg://caspra:caspra@postgres:5432/caspra
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-bytes
DEVICE_HMAC_SECRET=temporary-v1-migration-secret
DEVICE_SECRET_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
FIRMWARE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
DEVICE_HMAC_V1_ENABLED=false
# Only during an existing-device migration: enable v1 and set a bounded future sunset.
DEVICE_SIGNATURE_MAX_AGE_SECONDS=300
CORS_ORIGINS=["http://localhost:5173"]
