{
  "name": "caspra-operator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b --pretty false && vite build",
    "typecheck": "vue-tsc -b --pretty false",
    "generate:api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts",
    "check:icons": "node scripts/check-icons.mjs",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@remixicon/vue": "4.9",
    "@tanstack/vue-query": "^5.101.4",
    "chart.js": "^4.5.1",
    "vue": "3.5",
    "vue-chartjs": "^5.3.4",
    "vue-router": "4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.9"
  }
}
